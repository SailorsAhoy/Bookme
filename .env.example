# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/restaurant_booking?schema=public"

# Next.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# ============================================================
# TENANT MODE – choose one
# ============================================================

# A) SaaS multi-tenant (recommended for selling subscriptions)
ROOT_DOMAIN="localhost"          # or yoursaas.com in production

# B) One-off self-hosted install (client pays once)
# SINGLE_TENANT_SLUG="demo-restaurant"

# ============================================================
# Stripe (only needed for SaaS mode)
# ============================================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_PRICE_STARTER="price_..."
STRIPE_PRICE_PROFESSIONAL="price_..."
STRIPE_PRICE_ENTERPRISE="price_..."

# Auth
NEXTAUTH_SECRET="generate-a-long-random-string-here"
